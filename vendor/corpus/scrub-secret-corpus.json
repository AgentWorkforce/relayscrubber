      "id": "incident-escaped-json-tool-result",
      "input": "{\"type\":\"user\",\"message\":{\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_01\",\"content\":\"{\\n  \\\"username\\\": \\\"ops\\\",\\n  \\\"password\\\": \\\"{{cf_user_token}}\\\"\\n}\"}]}}",
      "expected": "{\"type\":\"user\",\"message\":{\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_01\",\"content\":\"{\\n  \\\"username\\\": \\\"ops\\\",\\n  \\\"password\\\": \\\"[REDACTED]\\\"\\n}\"}]}}"
