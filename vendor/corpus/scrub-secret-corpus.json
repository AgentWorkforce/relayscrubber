{
  "spec": "secret-scrub-corpus",
  "version": 1,
  "about": "Shared secret-scrubbing cases for lib/scrub.ts, kept byte-identical in AgentWorkforce/sessions-pipeline (packages/pipeline/test/fixtures) and AgentWorkforce/relayhistory-cloud (packages/relayhistory/test/fixtures). {{name}} placeholders are filled with fresh random values from `generators` at test time, so no secret-shaped string is ever stored here. Each case: scrubText(fill(input)) === fill(expected), no secret placeholder value survives, and scrubbing again is stable.",
  "charsets": {
    "alnum": "A-Z a-z 0-9",
    "upper_alnum": "A-Z 0-9",
    "letters": "A-Z a-z",
    "digits": "0-9",
    "hex": "0-9 a-f",
    "urlsafe": "A-Z a-z 0-9 _ -",
    "b64": "A-Z a-z 0-9 + /",
    "uuid": "a random v4 UUID (count ignored)",
    "lit": "the literal string"
  },
  "generators": {
    "tok53": {
      "parts": [["alnum", 53]]
    },
    "tok40": {
      "parts": [["alnum", 40]]
    },
    "pw": {
      "parts": [["alnum", 24]]
    },
    "cf_user_token": {
      "prefix": "cfut_",
      "parts": [
        ["alnum", 40],
        ["hex", 8]
      ]
    },
    "cf_account_token": {
      "prefix": "cfat_",
      "parts": [
        ["alnum", 40],
        ["hex", 8]
      ]
    },
    "cf_global_key": {
      "prefix": "cfk_",
      "parts": [
        ["alnum", 40],
        ["hex", 8]
      ]
    },
    "cf_legacy_global_key": {
      "parts": [["hex", 37]]
    },
    "cf_legacy_token": {
      "parts": [
        ["alnum", 20],
        ["urlsafe", 20]
      ]
    },
    "aws_access_key_id": {
      "prefix": "AKIA",
      "parts": [["upper_alnum", 16]]
    },
    "aws_temp_key_id": {
      "prefix": "ASIA",
      "parts": [["upper_alnum", 16]]
    },
    "aws_secret": {
      "parts": [
        ["alnum", 20],
        ["b64", 20]
      ]
    },
    "github_classic": {
      "prefix": "ghp_",
      "parts": [["alnum", 36]]
    },
    "github_oauth": {
      "prefix": "gho_",
      "parts": [["alnum", 36]]
    },
    "github_fine_grained": {
      "prefix": "github_pat_",
      "parts": [
        ["alnum", 22],
        ["lit", "_"],
        ["alnum", 59]
      ]
    },
    "gitlab": {
      "prefix": "glpat-",
      "parts": [["alnum", 20]]
    },
    "slack_bot": {
      "prefix": "xoxb-",
      "parts": [
        ["digits", 12],
        ["lit", "-"],
        ["digits", 13],
        ["lit", "-"],
        ["alnum", 24]
      ]
    },
    "slack_refresh": {
      "prefix": "xoxe-1-",
      "parts": [["alnum", 40]]
    },
    "stripe_live": {
      "prefix": "sk_live_",
      "parts": [["alnum", 24]]
    },
    "openai_project": {
      "prefix": "sk-proj-",
      "parts": [["urlsafe", 48]]
    },
    "anthropic": {
      "prefix": "sk-ant-api03-",
      "parts": [["urlsafe", 93]]
    },
    "google_api": {
      "prefix": "AIza",
      "parts": [["urlsafe", 35]]
    },
    "npm": {
      "prefix": "npm_",
      "parts": [["alnum", 36]]
    },
    "huggingface": {
      "prefix": "hf_",
      "parts": [["letters", 34]]
    },
    "sendgrid": {
      "prefix": "SG.",
      "parts": [
        ["urlsafe", 22],
        ["lit", "."],
        ["urlsafe", 43]
      ]
    },
    "sendgrid_embedded_prefix": {
      "prefix": "SG.",
      "parts": [
        ["urlsafe", 22],
        ["lit", "."],
        ["urlsafe", 10],
        ["lit", "-sk-"],
        ["urlsafe", 29]
      ]
    },
    "sendgrid_segment_prefix": {
      "prefix": "SG.",
      "parts": [
        ["urlsafe", 22],
        ["lit", ".sk-"],
        ["urlsafe", 40]
      ]
    },
    "gitlab_embedded_prefix": {
      "prefix": "glpat-",
      "parts": [
        ["alnum", 10],
        ["lit", "-sk-"],
        ["alnum", 20]
      ]
    },
    "google_api_embedded_prefix": {
      "prefix": "AIza",
      "parts": [
        ["alnum", 10],
        ["lit", "-ghp_"],
        ["alnum", 24]
      ]
    },
    "slack_hook_path": {
      "parts": [
        ["lit", "T"],
        ["upper_alnum", 10],
        ["lit", "/B"],
        ["upper_alnum", 10],
        ["lit", "/"],
        ["alnum", 24]
      ]
    },
    "pem_body": {
      "parts": [
        ["b64", 64],
        ["lit", "\n"],
        ["b64", 64]
      ]
    },
    "basic_cred": {
      "parts": [["b64", 28]]
    },
    "git_sha": {
      "parts": [["hex", 40]]
    },
    "short_sha": {
      "parts": [["hex", 7]]
    },
    "relay_glued_sk_prefix": {
      "prefix": "relay_ag_",
      "parts": [
        ["alnum", 10],
        ["lit", "-sk-"],
        ["alnum", 22],
        ["lit", "."],
        ["alnum", 6]
      ]
    },
    "sha256": {
      "parts": [["hex", 64]]
    },
    "uuid": {
      "parts": [["uuid", 1]]
    },
    "aws_account": {
      "parts": [["digits", 12]]
    },
    "quoted_at_cap": {
      "parts": [["alnum", 4096]]
    },
    "quoted_cap_plus_1": {
      "parts": [["alnum", 4097]]
    },
    "quoted_100k": {
      "parts": [["alnum", 102400]]
    },
    "quoted_total_over_cap_lines": {
      "parts": [
        ["alnum", 20],
        ["lit", "\n"],
        ["alnum", 2000],
        ["lit", "\u2028"],
        ["alnum", 2000],
        ["lit", "\r\n"],
        ["alnum", 200]
      ]
    },
    "quoted_over_cap_spaced": {
      "parts": [
        ["alnum", 3000],
        ["lit", " "],
        ["alnum", 3000]
      ]
    }
  },
  "secrets": [
    "anthropic",
    "aws_access_key_id",
    "aws_secret",
    "aws_temp_key_id",
    "basic_cred",
    "cf_account_token",
    "cf_global_key",
